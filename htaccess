<IfModule mod_rewrite.c>
  RewriteEngine On

  # ------------------------------
  # 0. Force HTTPS + www
  # ------------------------------
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^mcwinitech\.com\.au [NC]
  RewriteRule ^(.*)$ https://www.mcwinitech.com.au/$1 [L,R=301]

  # ------------------------------
  # 1. Serve existing files/folders
  # ------------------------------
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

</IfModule>